{
  "compilerOptions": {
    "target": "ES2022", "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "noEmit": true, "skipLibCheck": true, "baseUrl": "..", "paths": { "@/*": ["./*"] }
  },
  "include": ["shared/**/*.ts", "native/src/circles/**/*.ts"],
  "exclude": ["native/src/circles/android-member.ts"]
}
