{
  "name": "soe-synthetic-shell",
  "private": true,
  "version": "0.0.0",
  "main": "index.ts",
  "codegenConfig": {
    "name": "SoeMemberSpecs",
    "type": "modules",
    "jsSrcsDir": "specs",
    "android": {
      "javaPackageName": "com.anonymous.soesyntheticdemo.member"
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "export": "expo export --platform android --platform ios",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/auth-js": "2.99.3",
    "expo": "~58.0.12",
    "expo-status-bar": "~58.0.3",
    "react": "19.3.0",
    "react-native": "0.88.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
