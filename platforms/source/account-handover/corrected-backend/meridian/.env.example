# Optional. When set, Meridian uses Neon Postgres (free tier is enough).
DATABASE_URL=

# Optional. When a private Vercel Blob store is connected, the project receives
# BLOB_READ_WRITE_TOKEN and Meridian keeps one SQLite file there so preview
# instances share plans, consent, and revokes.
# BLOB_READ_WRITE_TOKEN=

# Required PKCS#8 PEM for the Ed25519 log key. Grants and revokes fail closed
# when this is missing. The private key is not stored in the database.
# This key only signs audit receipts. It is not a wallet.
MERIDIAN_SIGNING_PRIVATE_KEY=

# Required to reset demo data. Reset also requires a signed-in session.
# Set this on the preview environment only. Do not print the value in the app.
MERIDIAN_RESET_SECRET=
