  "query": "BEGIN TRANSACTION ISOLATION LEVEL REPEATABLE READ READ ONLY;\nSET LOCAL statement_timeout='2s';\nSELECT coalesce(jsonb_agg(jsonb_build_object(\n 'schema',n.nspname,'name',p.proname,'identity_arguments',pg_get_function_identity_arguments(p.oid),'result',pg_get_function_result(p.oid),\n 'language',l.lanname,'owner',pg_get_userbyid(p.proowner),'security_definer',p.prosecdef,'volatility',p.provolatile,\n 'config',p.proconfig,'body_md5',md5(p.prosrc),'body_characters',length(p.prosrc),\n 'acl',(SELECT coalesce(jsonb_agg(jsonb_build_object('grantor',pg_get_userbyid(a.grantor),'grantee',CASE WHEN a.grantee=0 THEN 'PUBLIC' ELSE pg_get_userbyid(a.grantee) END,'privilege',a.privilege_type,'grantable',a.is_grantable) ORDER BY a.grantee,a.privilege_type),'[]'::jsonb) FROM aclexplode(coalesce(p.proacl,acldefault('f',p.proowner))) a),\n 'effective_browser_execute',has_function_privilege('anon',p.oid,'EXECUTE') OR has_function_privilege('authenticated',p.oid,'EXECUTE'),\n 'effective_service_execute',has_function_privilege('service_role',p.oid,'EXECUTE'),\n 'referencing_policies',(SELECT coalesce(jsonb_agg(jsonb_build_object('schema',tn.nspname,'table',t.relname,'name',pol.polname,'command',pol.polcmd,'permissive',pol.polpermissive) ORDER BY tn.nspname,t.relname,pol.polname),'[]'::jsonb)\n   FROM pg_policy pol JOIN pg_class t ON t.oid=pol.polrelid JOIN pg_namespace tn ON tn.oid=t.relnamespace\n   WHERE EXISTS(SELECT 1 FROM pg_depend d WHERE d.classid='pg_policy'::regclass AND d.objid=pol.oid AND d.refclassid='pg_proc'::regclass AND d.refobjid=p.oid)),\n 'direct_dependents',(SELECT coalesce(jsonb_agg(jsonb_build_object('catalog',d.classid::regclass::text,'type',d.deptype,'subid',d.objsubid) ORDER BY d.classid,d.objid,d.objsubid),'[]'::jsonb) FROM pg_depend d WHERE d.refclassid='pg_proc'::regclass AND d.refobjid=p.oid)\n) ORDER BY p.proname,pg_get_function_identity_arguments(p.oid)),'[]'::jsonb) AS metadata\nFROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace JOIN pg_language l ON l.oid=p.prolang\nWHERE n.nspname='public' AND p.proname IN('add_exp','increment_exp','increment_exp_tokens','current_prompt_member_id');\nCOMMIT;",
